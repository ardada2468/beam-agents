{
  "name": "beam-agents-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for beam-agents. Content fidelity is enforced by scripts/ in the repository root; see website/README.md.",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:links": "node scripts/check_links.mjs",
    "check:ssr": "node scripts/check_site_ssr.mjs",
    "check:a11y": "node scripts/check_a11y.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "minisearch": "^7.1.2",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@next/eslint-plugin-next": "^16.2.12",
    "@shikijs/rehype": "^4.3.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "axe-core": "^4.10.2",
    "eslint": "^9.37.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.1.0",
    "next-mdx-remote": "^6.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4",
    "zod": "^4.1.11"
  }
}
