# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# mkdocs build output (`make docs`); deployed by the docs workflow, never committed
site/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Editors / OS
.DS_Store
.vscode/
.idea/

# mutmut
.mutmut-cache
mutants/

# pyperf benchmark results and the generated gate report (make bench /
# make bench-gate); the committed history is benchmark-baseline.toml.
bench-results/
bench-report.md

# e2e gate runtime artifacts (spool segments, worker logs, thread dumps).
# The directory itself is committed (.gitkeep): the compose bind mount must
# exist in a fresh checkout, or docker creates it root-owned on Linux CI
# runners and the host-side harness cannot write the run spool.
docker/e2e-spool/*
!docker/e2e-spool/.gitkeep
